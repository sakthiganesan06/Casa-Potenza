# ============================================================
# Voice-Enabled RAG System — Environment Variables Template
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to version control.
# ============================================================

# Sarvam AI API key (get from https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Groq API key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# Optional Overrides (defaults are configured in config.py)
# ============================================================

# Language subsets to ingest (comma-separated: hi,ta,bn,kn,ml,mr,te,gu,ur,or,pa,as,ne,sa)
INGEST_LANGUAGES=en,hi,ta,te

# Chunking strategy for retrieval (semantic | sliding)
CHUNKING_STRATEGY=semantic

# Groq model name
GROQ_MODEL=openai/gpt-oss-20b

# Storage & Log Paths
LANCE_DB_PATH=./lance_db
LOG_DIR=./logs
EVAL_OUTPUT_DIR=./eval/results
