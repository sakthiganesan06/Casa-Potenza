*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
.env/

# Logs
logs/
*.log

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Torch cache
torch_cache/

# Silero VAD cache
snakers4/

# Vector DB & Binaries
qdrant_db/
data_cache/
cloudflared.exe
*.zip
*.wav
